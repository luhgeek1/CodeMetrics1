NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgresql://postgres:secret@localhost:5444/hackathon
SITE_URL=https://localhost:8443

# Use a random secret outside local development. Existing RSA key pairs are supported.
JWT_SECRET=local-development-jwt-secret-change-before-deployment
CSRF_HMAC_KEY=local-development-csrf-secret-change-before-deployment
ACCESS_TTL=900
REFRESH_TTL=604800
COOKIE_SECURE=true
GRAPHQL_SANDBOX=true

# Optional external Source Code API
API_URL=
API_USERNAME=
API_PASSWORD=
API_AUTH_PATH=/api/auth/login
SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=0
SYNC_WINDOW_DAYS=365
