{
  "rootDir": ".",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/unit/**/*.spec.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "rootDir": ".",
          "esModuleInterop": true,
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "module": "ESNext",
          "moduleResolution": "Bundler"
        },
        "useESM": true
      }
    ]
  },
  "collectCoverageFrom": [
    "src/modules/analytics/analytics.calculations.ts",
    "src/modules/integration/diff-parser.ts"
  ],
  "coverageDirectory": "coverage",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
